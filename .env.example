# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Infrastructure (PostgreSQL Cloud)
# Note: Use the Service Role Key on the backend to act as the explicit Policy Enforcement Point (PEP)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-service-role-key-here

# Authentication & Cryptography
JWT_SECRET=your_super_secret_jwt_signing_key_min_32_chars
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12
